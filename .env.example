# Шаблон переменных для docker-compose. Скопируйте в .env и подставьте свои
# значения:  cp .env.example .env
# Файл .env в .gitignore — реальные пути/секреты в репозиторий не попадут.

# Пути к TLS-сертификату и ключу на хосте (нужны для HTTPS из docker-compose.yml).
# Сертификат должен содержать полную цепочку (leaf + промежуточные).
SSL_CERT_FILE=/etc/ssl/certs/mbp-iwtk.pem
SSL_KEY_FILE=/etc/ssl/certs/mbp-iwtk.key
